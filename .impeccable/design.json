      "description": "Surface-filled dialog field and native Account executable path adaptation.",
      "html": "<div class=\"ds-field-samples\"><input class=\"ds-field\" aria-label=\"Conversation name\" placeholder=\"Conversation name\" /><div class=\"ds-path\"><input aria-label=\"Codex executable path\" placeholder=\"Automatic detection\" /></div></div>",
      "css": ".ds-field{background:var(--surface);color:var(--text);border:1px solid var(--border);border-radius:7px;padding:11px 12px;font:13px -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;caret-color:var(--accent);}.ds-field::placeholder{color:var(--faint);}.ds-field:focus-visible{outline:2px solid var(--accent);outline-offset:3px;}.ds-field-samples{display:flex;flex-direction:column;gap:16px;}.ds-path{display:flex;gap:10px;align-items:center;background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:12px;color:var(--muted);}.ds-path input{width:100%;min-width:0;border:0;background:transparent;color:var(--text);font:12px -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;caret-color:var(--accent);}.ds-path input::placeholder{color:var(--faint);}.ds-path input:focus-visible{outline:2px solid var(--accent);outline-offset:3px;}",
      "refersTo": "field"
    },
    {
      "name": "Navigation Row",
      "kind": "nav",
      "description": "Understated desktop navigation with a raised new-conversation state.",
      "html": "<nav class=\"ds-nav\"><button class=\"ds-nav-row ds-new\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" aria-hidden=\"true\"><path d=\"M21 15a4 4 0 0 1-4 4H7l-4 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z\"/></svg>New conversation</button><button class=\"ds-nav-row\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" aria-hidden=\"true\"><path d=\"M21 15a4 4 0 0 1-4 4H7l-4 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z\"/></svg>Search conversations</button></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:3px;background:var(--sidebar);padding:12px;}.ds-nav-row{display:flex;align-items:center;gap:11px;min-height:40px;padding:10px 12px;border:0;border-radius:7px;background:transparent;color:var(--muted);text-align:left;font:14px -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;cursor:pointer;}.ds-nav-row:hover{background:var(--surface);color:var(--text);}.ds-nav-row.ds-new{background:var(--surface-raised);color:var(--text);margin-bottom:4px;}.ds-nav-row.ds-new:hover{background:var(--selected);}.ds-nav-row:focus-visible{outline:2px solid var(--accent);outline-offset:3px;}",
      "refersTo": "nav-item"
    },
    {
      "name": "Attachment Chip",
      "kind": "chip",
      "description": "Removable file context with a truncated name.",
      "html": "<div class=\"ds-chip\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" aria-hidden=\"true\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6\"/></svg><span>README.md</span><button aria-label=\"Remove README.md\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m18 6-12 12M6 6l12 12\"/></svg></button></div>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--border);border-radius:8px;background:var(--surface-raised);padding:6px 8px;color:var(--muted);font:11px -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;max-width:220px;}.ds-chip>span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}.ds-chip>button{display:flex;padding:2px;color:var(--muted);border:0;background:none;cursor:pointer;}.ds-chip>button:focus-visible{outline:2px solid var(--accent);outline-offset:3px;}",
      "refersTo": "attachment-chip"
    },
    {
      "name": "Composer",
      "kind": "card",
      "description": "The signature quiet message surface with compact send action.",
      "html": "<div class=\"ds-composer\"><textarea aria-label=\"Message Codex\" placeholder=\"How can I help you today?\" rows=\"2\"></textarea><div class=\"ds-toolbar\"><span>Chat \u00b7 Work</span><button class=\"ds-send\" aria-label=\"Send message\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m5 12 7-7 7 7M12 19V5\"/></svg></button></div></div>",
      "css": ".ds-composer{background:var(--surface);border:1px solid var(--border);border-radius:19px;padding:19px 18px 12px;box-shadow:0 4px 14px #00000008;color:var(--text);}.ds-composer:focus-within{border-color:color-mix(in srgb,var(--muted) 65%,var(--border));}.ds-composer textarea{display:block;width:100%;resize:none;border:0;background:transparent;color:var(--text);padding:0 0 16px;min-height:74px;max-height:240px;font:17px/1.55 -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;caret-color:var(--accent);}.ds-composer textarea::placeholder{color:var(--faint);}.ds-composer textarea:focus-visible{outline:none;}.ds-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;color:var(--muted);font:12px -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;}.ds-send{width:31px;height:31px;display:flex;align-items:center;justify-content:center;border:0;border-radius:8px;background:var(--accent);color:var(--accent-ink);cursor:pointer;}.ds-send:hover{background:var(--accent-hover);}.ds-send:focus-visible{outline:2px solid var(--accent);outline-offset:3px;}.ds-send:disabled{background:var(--selected);color:var(--muted);opacity:.65;}",
      "refersTo": "composer"
    },
    {
      "name": "Segmented Control",
      "kind": "custom",
      "description": "Compact preference choices with a neutral selected state.",
      "html": "<div class=\"ds-segments\" role=\"group\" aria-label=\"Text size\"><button>Small</button><button class=\"ds-selected\" aria-pressed=\"true\">Medium</button><button>Large</button></div>",
      "css": ".ds-segments{display:inline-flex;padding:3px;gap:1px;background:var(--surface-raised);border-radius:9px;}.ds-segments button{display:flex;align-items:center;justify-content:center;padding:8px 12px;color:var(--muted);border-radius:7px;min-width:42px;font:13px -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;border:0;background:transparent;cursor:pointer;}.ds-segments button.ds-selected{background:var(--selected);color:var(--text);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--border) 65%,var(--muted));}.ds-segments button:hover:not(.ds-selected){color:var(--text);}.ds-segments button:focus-visible{outline:2px solid var(--accent);outline-offset:3px;}",
      "refersTo": "segments"
    },
    {
      "name": "Toggle",
      "kind": "custom",
      "description": "Orange enabled track with a small translating circular thumb.",
      "html": "<button class=\"ds-toggle ds-on\" role=\"switch\" aria-checked=\"true\" aria-label=\"Enter to send\"><span></span></button>",
      "css": ".ds-toggle{width:37px;height:22px;border:0;border-radius:12px;background:var(--selected);padding:3px;cursor:pointer;}.ds-toggle>span{display:block;height:16px;width:16px;border-radius:50%;background:var(--muted);transition:transform .18s cubic-bezier(.16,1,.3,1);}.ds-toggle.ds-on{background:var(--accent);}.ds-toggle.ds-on>span{transform:translateX(15px);background:var(--accent-ink);}.ds-toggle:focus-visible{outline:2px solid var(--accent);outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-toggle>span{transition-duration:.001ms;}}"
    }
  ],
  "narrative": {
    "northStar": "A quiet personal Codex workspace",
    "overview": "The shipped interface follows the user-pinned Claude Desktop references: charcoal surfaces, warm white text, understated navigation, generous serif greeting, and plain aligned settings rows. The orange knot is the visual identity anchor. This document records `web/src/styles.css`, `web/index.html`, and the shared React components under `web/src/`; the reference screenshots establish the world, while the implementation establishes the values.\n\nThe conversation receives the largest uninterrupted area. Controls use compact system sans text, while the greeting and default assistant prose use Georgia. Depth comes primarily from neighboring surface tones and fine borders; menus and dialogs add soft shadows. The light theme preserves the same geometry and shifts the materials to warm paper tones.\n\nThe review in `.impeccable/review/desktop-style-review.md` records a scoped ship disposition for the shared home and General settings captures: `desktop.png`, `settings-desktop.png`, `mobile.png`, and `settings-mobile.png` in the same review directory. The native drag region, executable settings, and image preview below are recorded from source. Native window rendering and interaction, WebKit behavior, and Windows rendering remain unverified because the Mac was locked.",
    "keyCharacteristics": [
      "Warm neutral surfaces with a restrained orange accent.",
      "Serif greeting and reading text paired with compact sans controls.",
      "Centered conversation width with a persistent desktop navigation rail.",
      "Fine dividers, gently rounded controls, and aligned settings rows.",
      "Responsive drawers and horizontal settings navigation on small screens."
    ],
    "rules": [
      {
        "name": "The Semantic Surface Rule",
        "body": "Use the existing canvas, rail, surface, raised, selected, and dialog roles for their observed purposes; theme changes replace those roles together.",
        "section": "colors"
      },
      {
        "name": "The Action Orange Rule",
        "body": "Orange marks identity and actionable or active state; ordinary navigation and settings descriptions remain neutral.",
        "section": "colors"
      },
      {
        "name": "The Reading and Controls Rule",
        "body": "Preserve the separation between serif reading surfaces and system sans controls; transcript preferences change reading text, not the global interface face.",
        "section": "typography"
      },
      {
        "name": "The Overlay Depth Rule",
        "body": "Keep ordinary rows and navigation flat; use the existing soft shadow vocabulary for elevated composers, menus, dialogs, toasts, and drawers.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use semantic surface and text roles so dark and light themes move together.",
      "Do keep ordinary navigation neutral and reserve orange for identity, actions, focus, links, and active status.",
      "Do preserve serif reading text and compact system sans controls, including user transcript preferences.",
      "Do keep transcript and composer widths linked, and use drawers and horizontal settings navigation at the existing mobile breakpoint.",
      "Do retain fine dividers, aligned settings rows, visible focus, and reduced-motion behavior."
    ],
    "donts": [
      "Don't introduce hard offset shadows into this quiet, softly layered world.",
      "Don't replace the pinned knot identity or serif greeting with an unrelated visual style.",
      "Don't turn user attachment imagery or isolated content formatting into reusable brand decoration.",
      "Don't replace plain settings rows with decorative card grids."
    ]
  }
}
